# Contact form (EmailJS) — public keys, safe to expose in the client bundle.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# --- Insights / remote blog (shared blogs CMS) ---
# Base URL of the blogs backend.
NEXT_PUBLIC_BLG_API_URL=https://blg-api.nxtgenaidev.com
# Org this site authenticates AS — the CMS returns only this org's posts (X-Organization-Id).
NEXT_PUBLIC_BLG_ORG_ID=6a21a62ca1d17d43907d568f
# Optional channel filter; leave blank to show all of the org's published posts.
BLG_PROJECT_KEY=nextgenai
# CMS API key bound to the org above (sent as X-API-Key). SERVER-ONLY — never NEXT_PUBLIC_.
# Put the real blg_live_/blg_test_ key in .env.local (git-ignored), not here.
BLG_API_KEY=
